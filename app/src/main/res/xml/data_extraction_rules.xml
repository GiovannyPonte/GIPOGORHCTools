<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="gipogo_rhc_tools.db" />
        <exclude domain="database" path="gipogo_rhc_tools.db.bak_plain" />
        <exclude domain="database" path="gipogo_rhc_tools.db.enc_tmp" />
        <exclude domain="database" path="gipogo_rhc_tools.db-wal" />
        <exclude domain="database" path="gipogo_rhc_tools.db-shm" />
        <exclude domain="sharedpref" path="db_crypto_prefs.xml" />
        <exclude domain="sharedpref" path="db_key_material_v2.xml" />
        <exclude domain="sharedpref" path="auth_session_prefs.xml" />
        <exclude domain="sharedpref" path="workshop_recovery_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="gipogo_rhc_tools.db" />
        <exclude domain="database" path="gipogo_rhc_tools.db.bak_plain" />
        <exclude domain="database" path="gipogo_rhc_tools.db.enc_tmp" />
        <exclude domain="database" path="gipogo_rhc_tools.db-wal" />
        <exclude domain="database" path="gipogo_rhc_tools.db-shm" />
        <exclude domain="sharedpref" path="db_crypto_prefs.xml" />
        <exclude domain="sharedpref" path="db_key_material_v2.xml" />
        <exclude domain="sharedpref" path="auth_session_prefs.xml" />
        <exclude domain="sharedpref" path="workshop_recovery_prefs.xml" />
        <exclude domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
